# 生产环境变量示例（复制为 .env 使用）

# ==================== 服务器配置 ====================
# 服务器的公网IP或域名，用于 Kafka 外部访问
KAFKA_EXTERNAL_HOST=your-server-ip-or-domain.com

# ==================== 数据库凭证（可选修改） ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator

# ==================== 应用配置 ====================
AUTH_SERVICE_DEBUG=false

# ==================== ai_service（LLM 与向量） ====================
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_EMBEDDING_API_KEY=
SILICONFLOW_RERANKER_API_KEY=
HTTP_PROXY=

# ==================== 资源限制（根据服务器配置调整） ====================
MEMORY_LIMIT_POSTGRES=512m
MEMORY_LIMIT_MONGODB=512m
MEMORY_LIMIT_REDIS=256m
MEMORY_LIMIT_KAFKA=1024m
MEMORY_LIMIT_ZOOKEEPER=256m
MEMORY_LIMIT_AUTH_SERVICE=512m
MEMORY_LIMIT_CHAT_SERVICE=512m
MEMORY_LIMIT_AI_SERVICE=512m
MEMORY_LIMIT_ORCHESTRATOR_SERVICE=512m

CPU_LIMIT_POSTGRES=0.5
CPU_LIMIT_MONGODB=0.5
CPU_LIMIT_REDIS=0.2
CPU_LIMIT_KAFKA=1.0
CPU_LIMIT_ZOOKEEPER=0.2
CPU_LIMIT_AUTH_SERVICE=0.5
CPU_LIMIT_CHAT_SERVICE=0.5
CPU_LIMIT_AI_SERVICE=0.5
CPU_LIMIT_ORCHESTRATOR_SERVICE=0.5
