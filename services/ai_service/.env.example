# ai_service 环境变量示例（复制为 .env 使用）
kafka_brokers=localhost:9094
kafka_topic=chat_group_message
kafka_group_id=ai_service_group
ai_user_id=ai-assistant

# 密钥（只放 .env / 环境变量；llm_relay/config/config.json 里只存变量名）
deepseek_api_key=

# 成本审计（PostgreSQL）
cost_tracking_enabled=true
cost_db_host=localhost
cost_db_port=5432
cost_db_user=postgres
cost_db_password=postgres
cost_db_name=ai_audit
cost_table_name=llm_api_costs

# 短期记忆折叠检查点（存储服务接入前的临时实现，直连 Mongo）
memory_mongo_url=mongodb://localhost:27017
memory_mongo_db=chat
memory_checkpoint_collection=conversation_memory

# 代理（可选）
http_proxy=
