# ai_service 环境变量示例（复制为 .env 使用）
kafka_brokers=localhost:9094
kafka_topic=chat_group_message
ai_user_id=ai-assistant
ai_research_user_id=ai-research

# LLM（DeepSeek）
llm_provider=deepseek
deepseek_api_key=
deepseek_base_url=https://api.deepseek.com/v1
deepseek_model=deepseek-chat

# SiliconFlow（embedding / rerank）
siliconflow_embedding_api_key=
siliconflow_reranker_api_key=

# 依赖服务
chat_service_url=http://localhost:8080
internal_api_key=chant-internal-2026
searxng_base_url=http://localhost:8888
qdrant_url=http://localhost:6333
qdrant_collection=long_term_memory

# 成本审计（PostgreSQL）
cost_tracking_enabled=true
cost_db_host=localhost
cost_db_port=5432
cost_db_user=postgres
cost_db_password=postgres
cost_db_name=ai_audit
cost_table_name=llm_api_costs

# 滑动窗口
sliding_window_size=20
sliding_window_summary_threshold=10

# 代理（可选）
http_proxy=
